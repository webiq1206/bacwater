modules = ["nodejs-22", "python-3.11", "postgresql-16"]
hidden = [".config", ".next", "node_modules"]

run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
# Schema is synced without --accept-data-loss: if a change would drop a column
# or table, the deploy fails loudly instead of silently destroying prod data.
# Seeding is NOT run here -- prisma/seed.ts upserts and force-sets
# published: true, so running it on deploy reverts admin content edits and
# re-publishes anything unpublished. Seed manually with `npm run db:seed`.
build = ["sh", "-c", "npm install --include=dev && npx prisma generate && npx prisma db push --skip-generate && npm run build"]
run = ["sh", "-c", "npm start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start -- -p 5000"
waitForPort = 5000

