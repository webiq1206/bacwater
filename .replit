modules = ["nodejs-22", "python-3.11", "postgresql-16"]
hidden = [".config", ".next", "node_modules"]
run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
# Production deploys are read-only with respect to schema/content.
# Replit's production database migration UI must never be approved for destructive drops.
build = ["sh", "-c", "npm ci --include=dev && npx prisma generate && npx tsx scripts/verify-deploy-schema.ts && npm run build"]
run = ["sh", "-c", "npm start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start -- -p 5000"
waitForPort = 5000
