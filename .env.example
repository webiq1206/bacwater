# Database
# Postgres only. prisma/schema.prisma declares provider = "postgresql", so a
# SQLite "file:" URL will fail schema validation before it ever connects.
# Local dev: createdb bacwater_dev
DATABASE_URL="postgresql://USER@localhost:5432/bacwater_dev"
# Production Neon connections should use the pooled endpoint, with "-pooler"
# in the host. Example:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="BACWater.ai"

# Auth
AUTH_SECRET="replace-me-with-a-32-char-random-string"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email
RESEND_API_KEY=""
RESEND_FROM="BACwater.ai <hello@bacwater.ai>"

# Optional AI topic classifier. Use a model available to the provider account.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
AI_TOPIC_ROUTING_ENABLED="false"

# Administration is granted only through the stored user role after operator verification.
# Registration does not grant privileges based on an email allowlist.

# Optional privacy-preserving analytics. Leave disabled until receiving-side checks pass.
NEXT_PUBLIC_GA_ID="G-CWEKGP6NKB"
# Before enabling: disable Enhanced Measurement/history tracking, user-provided data,
# advertising signals and automatic form events in the GA4 property. Verify requests
# contain no personal data, compound identities, share IDs or query strings.
NEXT_PUBLIC_ANALYTICS_MANUAL_CONFIRMED="false"

# The owner approved the public WEBIQ affiliate code on September 24, 2026.
# It is configured centrally in src/lib/partners/supplier-catalog.ts.
# No account password, payout credentials or private token belongs here.
# Set this to true and restart/redeploy to pause affiliate attribution.
# A required supplier-content takedown needs a separate content removal.
AMINO_CLUB_AFFILIATE_PAUSED="false"
# Legacy AMINO_CLUB_ENABLED, AMINO_CLUB_APPROVAL_AND_LINKS_VERIFIED and
# AMINO_CLUB_PRODUCT_LINKS_JSON variables no longer control the default catalog.
# Actual supplier conversion credit and payout eligibility require merchant-side verification.
